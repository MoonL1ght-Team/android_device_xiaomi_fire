#!/sbin/sh
# SPDX-License-Identifier: Apache-2.0

OUTFD="$2"
ZIPFILE="$3"
MODE="__MODE__"
TITLE="__TITLE__"
BIN_NAME="fire-gki66-repartition"
BIN_ZIP_PATH="tools/${BIN_NAME}"
BIN_TMP="/tmp/${BIN_NAME}"
LOG="/tmp/fire-gki66-vendor_boot-repartition.log"
LOG_COPY="/sdcard/fire-gki66-vendor_boot-repartition.log"
UI_FD="/proc/self/fd/${OUTFD}"
USE_UI_PROTOCOL=1

fd_target() {
    readlink "$1" 2>/dev/null || printf '%s' ""
}

case "$OUTFD" in
    ""|*[!0-9]*|0)
        USE_UI_PROTOCOL=0
        ;;
esac

[ "$USE_UI_PROTOCOL" = 0 ] || [ -e "$UI_FD" ] || USE_UI_PROTOCOL=0

emit_recovery() {
    if [ "$USE_UI_PROTOCOL" = 1 ] && [ -n "$OUTFD" ] && [ -e "$UI_FD" ]; then
        printf '%s\n' "$1" >> "$UI_FD"
    fi
}

ui_print() {
    line="$*"
    if [ "$USE_UI_PROTOCOL" = 1 ]; then
        emit_recovery "ui_print ${line}"
        emit_recovery "ui_print"
    else
        printf '%s\n' "$line"
    fi
    printf '%s\n' "$line" >> "$LOG"
}

set_progress() {
    emit_recovery "set_progress $1"
}

abort() {
    ui_print "ERROR: $*"
    ui_print "Log: $LOG"
    cp -f "$LOG" "$LOG_COPY" 2>/dev/null
    exit 1
}

extract_payload() {
    unzip_bin=""
    for candidate in unzip /sbin/unzip /system/bin/unzip /system/xbin/unzip /tmp/unzip; do
        if command -v "$candidate" >/dev/null 2>&1; then
            unzip_bin="$candidate"
            break
        fi
    done

    [ -n "$unzip_bin" ] || abort "unzip is missing in this recovery"
    "$unzip_bin" -p "$ZIPFILE" "$BIN_ZIP_PATH" > "$BIN_TMP" 2>>"$LOG" ||
        abort "failed to extract native payload"
    chmod 0755 "$BIN_TMP" 2>>"$LOG" || abort "failed to chmod native payload"
}

rm -f "$LOG"
touch "$LOG" 2>/dev/null || LOG="/tmp/fire-gki66-repartition-fallback.log"
printf 'OUTFD: %s\n' "$OUTFD" >> "$LOG"
printf 'OUTFD target: %s\n' "$(fd_target "$UI_FD")" >> "$LOG"
printf 'stdout target: %s\n' "$(fd_target /proc/self/fd/1)" >> "$LOG"

ui_print "----------------------------------------"
ui_print "$TITLE"
ui_print "Recovery UI: update-binary shell wrapper"
ui_print "Output mode: $([ "$USE_UI_PROTOCOL" = 1 ] && printf protocol || printf plain)"
ui_print "ZIP: $ZIPFILE"
ui_print "Mode: $MODE"
ui_print "----------------------------------------"
set_progress 0.05

extract_payload
ui_print "Native payload extracted: $BIN_TMP"
set_progress 0.20

NATIVE_LOG="/tmp/fire-gki66-native.log"
RAW_NATIVE_LOG="/tmp/fire-gki66-native.raw.log"
rm -f "$NATIVE_LOG" "$RAW_NATIVE_LOG"
"$BIN_TMP" --plain "$MODE" > "$RAW_NATIVE_LOG" 2>&1
RC=$?

while IFS= read -r line || [ -n "$line" ]; do
    case "$line" in
        ui_print)
            continue
            ;;
        ui_print\ *)
            line=${line#ui_print }
            ;;
    esac
    printf '%s\n' "$line" >> "$NATIVE_LOG"
    ui_print "$line"
done < "$RAW_NATIVE_LOG"
printf 'Raw native log: %s\n' "$RAW_NATIVE_LOG" >> "$LOG"

if [ "$RC" != "0" ]; then
    abort "native payload failed with rc=$RC"
fi

set_progress 0.95
cp -f "$LOG" "$LOG_COPY" 2>/dev/null &&
    ui_print "Install log copied: $LOG_COPY" ||
    ui_print "Install log kept at: $LOG"
ui_print "Reboot recovery before checking blockdev sizes."
set_progress 1.00
ui_print "Done."
exit 0
