FIRE_KERNEL_VERSION ?= 6.6
FIRE_KERNEL_BUILD_TYPE ?= source

ifneq ($(filter source prebuilt,$(FIRE_KERNEL_BUILD_TYPE)),$(FIRE_KERNEL_BUILD_TYPE))
$(error Unsupported FIRE_KERNEL_BUILD_TYPE "$(FIRE_KERNEL_BUILD_TYPE)"; use source or prebuilt)
endif

FIRE_KERNEL_4_19_SOURCE ?= kernel/xiaomi/fire
FIRE_KERNEL_4_19_PREBUILT_DIR ?= $(FIRE_KERNEL_4_19_SOURCE)/out/fire/AnyKernel3
FIRE_KERNEL_4_19_PREBUILT_IMAGE ?= $(FIRE_KERNEL_4_19_PREBUILT_DIR)/Image.gz-dtb
FIRE_KERNEL_4_19_PREBUILT_DTBO ?= $(FIRE_KERNEL_4_19_PREBUILT_DIR)/dtbo.img

FIRE_KERNEL_6_6_PLATFORM ?= kernel_platform/kernel
FIRE_KERNEL_6_6_MODULES_DIR ?= kernel_device_modules-6.6
FIRE_KERNEL_6_6_SOURCE ?= $(FIRE_KERNEL_6_6_PLATFORM)/$(FIRE_KERNEL_6_6_MODULES_DIR)
FIRE_KERNEL_6_6_PROJECT ?= mgk_64_k66
FIRE_KERNEL_6_6_MODE ?= $(if $(TARGET_BUILD_VARIANT),$(TARGET_BUILD_VARIANT),userdebug)
FIRE_KERNEL_6_6_SOURCE_DIST_DIR ?= $(abspath $(FIRE_KERNEL_6_6_SOURCE)/dist/rom/$(FIRE_KERNEL_6_6_PROJECT).$(FIRE_KERNEL_6_6_MODE))
FIRE_KERNEL_6_6_PREBUILT_DIR ?= $(FIRE_KERNEL_6_6_SOURCE_DIST_DIR)
FIRE_KERNEL_6_6_DIST_DIR ?= $(if $(filter prebuilt,$(FIRE_KERNEL_BUILD_TYPE)),$(FIRE_KERNEL_6_6_PREBUILT_DIR),$(FIRE_KERNEL_6_6_SOURCE_DIST_DIR))
FIRE_KERNEL_6_6_IMAGE_COMPRESSION ?= gzip
ifneq ($(filter gzip lz4,$(FIRE_KERNEL_6_6_IMAGE_COMPRESSION)),$(FIRE_KERNEL_6_6_IMAGE_COMPRESSION))
$(error Unsupported FIRE_KERNEL_6_6_IMAGE_COMPRESSION "$(FIRE_KERNEL_6_6_IMAGE_COMPRESSION)"; use gzip or lz4)
endif
FIRE_KERNEL_6_6_IMAGE_NAME := $(if $(filter lz4,$(FIRE_KERNEL_6_6_IMAGE_COMPRESSION)),Image.lz4,Image.gz)
FIRE_KERNEL_6_6_DIST_IMAGE ?= $(FIRE_KERNEL_6_6_DIST_DIR)/$(FIRE_KERNEL_6_6_IMAGE_NAME)
FIRE_KERNEL_6_6_DIST_DTB ?= $(FIRE_KERNEL_6_6_DIST_DIR)/dtb.img
FIRE_KERNEL_6_6_DIST_DTBO ?= $(FIRE_KERNEL_6_6_DIST_DIR)/dtbo.img
FIRE_KERNEL_6_6_PREBUILT_IMAGE ?= $(FIRE_KERNEL_6_6_DIST_IMAGE)
FIRE_KERNEL_6_6_PREBUILT_DTB ?= $(FIRE_KERNEL_6_6_DIST_DTB)
FIRE_KERNEL_6_6_PREBUILT_DTBO ?= $(FIRE_KERNEL_6_6_DIST_DTBO)
FIRE_KERNEL_6_6_SCATTER_SOURCE ?= $(firstword $(wildcard \
    $(DEVICE_PATH)/kernel/6.6/MT6768_Android_scatter.xml \
    $(DEVICE_PATH)/kernel/6.6/MT6768_Android_scatter.txt \
    vendor/xiaomi/fire/MT6768_Android_scatter.xml \
    vendor/xiaomi/fire/MT6768_Android_scatter.txt))
# This is a stock HyperOS 2 layout validator/export. The ROM build does not
# generate a custom repartition plan; devices must already use the stock GPT.
FIRE_KERNEL_6_6_SCATTER_OUTPUT ?= $(if $(FIRE_KERNEL_6_6_SCATTER_SOURCE),$(FIRE_KERNEL_6_6_DIST_DIR)/$(notdir $(FIRE_KERNEL_6_6_SCATTER_SOURCE)))
FIRE_KERNEL_6_6_MODULE_SRC_DIR ?= $(FIRE_KERNEL_6_6_DIST_DIR)/modules/vendor/lib/modules
FIRE_KERNEL_6_6_VENDOR_BOOT_MODULE_LIST ?= $(DEVICE_PATH)/kernel/6.6/vendor_boot.modules.list
FIRE_KERNEL_6_6_VENDOR_BOOT_MODULE_LOAD ?= $(DEVICE_PATH)/kernel/6.6/vendor_boot.modules.load
FIRE_KERNEL_6_6_VENDOR_BOOT_RECOVERY_MODULE_LOAD ?= $(DEVICE_PATH)/kernel/6.6/vendor_boot.modules.load.recovery
FIRE_KERNEL_6_6_VENDOR_DLKM_MODULE_LIST ?= $(DEVICE_PATH)/kernel/6.6/vendor_dlkm.modules.list
FIRE_KERNEL_6_6_VENDOR_DLKM_MODULE_LOAD ?= $(DEVICE_PATH)/kernel/6.6/vendor_dlkm.modules.load
FIRE_KERNEL_6_6_SYSTEM_DLKM_MODULE_LIST ?= $(DEVICE_PATH)/kernel/6.6/system_dlkm.modules.list
FIRE_KERNEL_6_6_SYSTEM_DLKM_MODULE_LOAD ?= $(DEVICE_PATH)/kernel/6.6/system_dlkm.modules.load
FIRE_KERNEL_6_6_VENDOR_MODULE_LIST ?= $(FIRE_KERNEL_6_6_VENDOR_DLKM_MODULE_LIST)
FIRE_KERNEL_6_6_VENDOR_BOOT ?= true
# Stock HyperOS 2 keeps vendor_boot_a/b at 64 MiB and stores the complete
# first-stage/recovery module set there.
FIRE_KERNEL_6_6_VENDOR_BOOTIMAGE_PARTITION_SIZE ?= 67108864
FIRE_KERNEL_6_6_BOOT_CMDLINE ?=
FIRE_KERNEL_6_6_VENDOR_CMDLINE ?= bootopt=64S3,32N2,64N2
FIRE_KERNEL_6_6_BOOTCONFIG ?=
FIRE_KERNEL_6_6_EXPECT_TEXT_OFFSET ?= 0x0
FIRE_KERNEL_6_6_VENDOR_BOOT_MODULE_NAMES := $(strip $(shell sed -n '/[.]ko$$/p' $(FIRE_KERNEL_6_6_VENDOR_BOOT_MODULE_LIST) 2>/dev/null))
FIRE_KERNEL_6_6_VENDOR_BOOT_MODULE_LOAD_NAMES := $(strip $(shell sed -n '/[.]ko$$/p' $(FIRE_KERNEL_6_6_VENDOR_BOOT_MODULE_LOAD) 2>/dev/null))
FIRE_KERNEL_6_6_VENDOR_BOOT_RECOVERY_MODULE_LOAD_NAMES := $(strip $(shell sed -n '/[.]ko$$/p' $(FIRE_KERNEL_6_6_VENDOR_BOOT_RECOVERY_MODULE_LOAD) 2>/dev/null))
FIRE_KERNEL_6_6_VENDOR_DLKM_MODULE_NAMES := $(strip $(shell sed -n '/[.]ko$$/p' $(FIRE_KERNEL_6_6_VENDOR_DLKM_MODULE_LIST) 2>/dev/null))
FIRE_KERNEL_6_6_VENDOR_DLKM_MODULE_LOAD_NAMES := $(strip $(shell sed -n '/[.]ko$$/p' $(FIRE_KERNEL_6_6_VENDOR_DLKM_MODULE_LOAD) 2>/dev/null))
FIRE_KERNEL_6_6_SYSTEM_DLKM_MODULE_NAMES := $(strip $(shell sed -n '/[.]ko$$/p' $(FIRE_KERNEL_6_6_SYSTEM_DLKM_MODULE_LIST) 2>/dev/null))
FIRE_KERNEL_6_6_SYSTEM_DLKM_MODULE_LOAD_NAMES := $(strip $(shell sed -n '/[.]ko$$/p' $(FIRE_KERNEL_6_6_SYSTEM_DLKM_MODULE_LOAD) 2>/dev/null))
FIRE_KERNEL_6_6_VENDOR_MODULE_NAMES := $(FIRE_KERNEL_6_6_VENDOR_DLKM_MODULE_NAMES)
FIRE_KERNEL_6_6_VENDOR_BOOT_MODULES := $(addprefix $(FIRE_KERNEL_6_6_MODULE_SRC_DIR)/,$(FIRE_KERNEL_6_6_VENDOR_BOOT_MODULE_NAMES))
FIRE_KERNEL_6_6_VENDOR_BOOT_MODULE_LOAD_FILES := $(addprefix $(FIRE_KERNEL_6_6_MODULE_SRC_DIR)/,$(FIRE_KERNEL_6_6_VENDOR_BOOT_MODULE_LOAD_NAMES))
FIRE_KERNEL_6_6_VENDOR_BOOT_RECOVERY_MODULE_LOAD_FILES := $(addprefix $(FIRE_KERNEL_6_6_MODULE_SRC_DIR)/,$(FIRE_KERNEL_6_6_VENDOR_BOOT_RECOVERY_MODULE_LOAD_NAMES))
FIRE_KERNEL_6_6_VENDOR_DLKM_MODULES := $(addprefix $(FIRE_KERNEL_6_6_MODULE_SRC_DIR)/,$(FIRE_KERNEL_6_6_VENDOR_DLKM_MODULE_NAMES))
FIRE_KERNEL_6_6_VENDOR_DLKM_MODULE_LOAD_FILES := $(addprefix $(FIRE_KERNEL_6_6_MODULE_SRC_DIR)/,$(FIRE_KERNEL_6_6_VENDOR_DLKM_MODULE_LOAD_NAMES))
FIRE_KERNEL_6_6_SYSTEM_DLKM_MODULES := $(addprefix $(FIRE_KERNEL_6_6_MODULE_SRC_DIR)/,$(FIRE_KERNEL_6_6_SYSTEM_DLKM_MODULE_NAMES))
FIRE_KERNEL_6_6_SYSTEM_DLKM_MODULE_LOAD_FILES := $(addprefix $(FIRE_KERNEL_6_6_MODULE_SRC_DIR)/,$(FIRE_KERNEL_6_6_SYSTEM_DLKM_MODULE_LOAD_NAMES))
FIRE_KERNEL_6_6_VENDOR_MODULES := $(FIRE_KERNEL_6_6_VENDOR_DLKM_MODULES)
FIRE_KERNEL_6_6_REQUIRED_DIST_FILES := \
    $(FIRE_KERNEL_6_6_DIST_IMAGE) \
    $(FIRE_KERNEL_6_6_DIST_DTB) \
    $(FIRE_KERNEL_6_6_DIST_DTBO)
FIRE_KERNEL_6_6_GENERATED_SCATTER := $(strip $(FIRE_KERNEL_6_6_SCATTER_OUTPUT))
FIRE_KERNEL_6_6_MISSING_DIST_FILES := $(strip $(foreach file,$(FIRE_KERNEL_6_6_REQUIRED_DIST_FILES),$(if $(wildcard $(file)),,$(file))))
FIRE_KERNEL_6_6_MISSING_VENDOR_BOOT_MODULES := $(strip $(foreach file,$(FIRE_KERNEL_6_6_VENDOR_BOOT_MODULES),$(if $(wildcard $(file)),,$(file))))
FIRE_KERNEL_6_6_MISSING_VENDOR_BOOT_LOAD_MODULES := $(strip $(foreach file,$(FIRE_KERNEL_6_6_VENDOR_BOOT_MODULE_LOAD_FILES),$(if $(wildcard $(file)),,$(file))))
FIRE_KERNEL_6_6_MISSING_VENDOR_BOOT_RECOVERY_LOAD_MODULES := $(strip $(foreach file,$(FIRE_KERNEL_6_6_VENDOR_BOOT_RECOVERY_MODULE_LOAD_FILES),$(if $(wildcard $(file)),,$(file))))
FIRE_KERNEL_6_6_MISSING_VENDOR_DLKM_MODULES := $(strip $(foreach file,$(FIRE_KERNEL_6_6_VENDOR_DLKM_MODULES),$(if $(wildcard $(file)),,$(file))))
FIRE_KERNEL_6_6_MISSING_VENDOR_DLKM_LOAD_MODULES := $(strip $(foreach file,$(FIRE_KERNEL_6_6_VENDOR_DLKM_MODULE_LOAD_FILES),$(if $(wildcard $(file)),,$(file))))
FIRE_KERNEL_6_6_MISSING_SYSTEM_DLKM_MODULES := $(strip $(foreach file,$(FIRE_KERNEL_6_6_SYSTEM_DLKM_MODULES),$(if $(wildcard $(file)),,$(file))))
FIRE_KERNEL_6_6_MISSING_SYSTEM_DLKM_LOAD_MODULES := $(strip $(foreach file,$(FIRE_KERNEL_6_6_SYSTEM_DLKM_MODULE_LOAD_FILES),$(if $(wildcard $(file)),,$(file))))

TARGET_KERNEL_ARCH := arm64
TARGET_KERNEL_HEADER_ARCH := arm64
TARGET_KERNEL_NO_GCC := true

ifeq ($(FIRE_KERNEL_VERSION),4.19)
TARGET_KERNEL_SOURCE := $(FIRE_KERNEL_4_19_SOURCE)
TARGET_KERNEL_CONFIG := fire_defconfig
BOARD_KERNEL_IMAGE_NAME := Image.gz

ifeq ($(FIRE_KERNEL_BUILD_TYPE),prebuilt)
TARGET_PREBUILT_KERNEL := $(FIRE_KERNEL_4_19_PREBUILT_IMAGE)
BOARD_PREBUILT_DTBOIMAGE := $(FIRE_KERNEL_4_19_PREBUILT_DTBO)
endif
else ifeq ($(FIRE_KERNEL_VERSION),6.6)
ifeq ($(FIRE_KERNEL_6_6_VENDOR_MODULE_NAMES),)
$(error Fire 6.6 vendor_dlkm module list is empty: $(FIRE_KERNEL_6_6_VENDOR_DLKM_MODULE_LIST))
endif
ifeq ($(FIRE_KERNEL_6_6_VENDOR_BOOT_MODULE_NAMES),)
$(error Fire 6.6 vendor_boot module list is empty: $(FIRE_KERNEL_6_6_VENDOR_BOOT_MODULE_LIST))
endif
ifeq ($(FIRE_KERNEL_6_6_VENDOR_BOOT_MODULE_LOAD_NAMES),)
$(error Fire 6.6 vendor_boot modules.load is empty: $(FIRE_KERNEL_6_6_VENDOR_BOOT_MODULE_LOAD))
endif
ifeq ($(FIRE_KERNEL_6_6_VENDOR_BOOT_RECOVERY_MODULE_LOAD_NAMES),)
$(error Fire 6.6 vendor_boot modules.load.recovery is empty: $(FIRE_KERNEL_6_6_VENDOR_BOOT_RECOVERY_MODULE_LOAD))
endif
ifeq ($(FIRE_KERNEL_6_6_VENDOR_DLKM_MODULE_LOAD_NAMES),)
$(error Fire 6.6 vendor_dlkm modules.load is empty: $(FIRE_KERNEL_6_6_VENDOR_DLKM_MODULE_LOAD))
endif
ifeq ($(FIRE_KERNEL_6_6_SYSTEM_DLKM_MODULE_NAMES),)
$(error Fire 6.6 system_dlkm module list is empty: $(FIRE_KERNEL_6_6_SYSTEM_DLKM_MODULE_LIST))
endif
ifeq ($(FIRE_KERNEL_6_6_SYSTEM_DLKM_MODULE_LOAD_NAMES),)
$(error Fire 6.6 system_dlkm modules.load is empty: $(FIRE_KERNEL_6_6_SYSTEM_DLKM_MODULE_LOAD))
endif
ifeq ($(FIRE_KERNEL_6_6_SCATTER_SOURCE),)
$(error Fire 6.6 scatter source is missing: keep kernel/6.6/MT6768_Android_scatter.xml in this tree or set FIRE_KERNEL_6_6_SCATTER_SOURCE)
endif
ifeq ($(FIRE_KERNEL_BUILD_TYPE),prebuilt)
ifneq ($(FIRE_KERNEL_6_6_MISSING_DIST_FILES),)
$(error Missing Fire 6.6 kernel dist files: $(FIRE_KERNEL_6_6_MISSING_DIST_FILES))
endif
ifneq ($(FIRE_KERNEL_6_6_MISSING_VENDOR_BOOT_MODULES),)
$(error Missing Fire 6.6 vendor_boot modules: $(FIRE_KERNEL_6_6_MISSING_VENDOR_BOOT_MODULES))
endif
ifneq ($(FIRE_KERNEL_6_6_MISSING_VENDOR_BOOT_LOAD_MODULES),)
$(error Missing Fire 6.6 vendor_boot load modules: $(FIRE_KERNEL_6_6_MISSING_VENDOR_BOOT_LOAD_MODULES))
endif
ifneq ($(FIRE_KERNEL_6_6_MISSING_VENDOR_BOOT_RECOVERY_LOAD_MODULES),)
$(error Missing Fire 6.6 vendor_boot recovery load modules: $(FIRE_KERNEL_6_6_MISSING_VENDOR_BOOT_RECOVERY_LOAD_MODULES))
endif
ifneq ($(FIRE_KERNEL_6_6_MISSING_VENDOR_DLKM_MODULES),)
$(error Missing Fire 6.6 vendor_dlkm modules: $(FIRE_KERNEL_6_6_MISSING_VENDOR_DLKM_MODULES))
endif
ifneq ($(FIRE_KERNEL_6_6_MISSING_VENDOR_DLKM_LOAD_MODULES),)
$(error Missing Fire 6.6 vendor_dlkm load modules: $(FIRE_KERNEL_6_6_MISSING_VENDOR_DLKM_LOAD_MODULES))
endif
ifneq ($(FIRE_KERNEL_6_6_MISSING_SYSTEM_DLKM_MODULES),)
$(error Missing Fire 6.6 system_dlkm modules: $(FIRE_KERNEL_6_6_MISSING_SYSTEM_DLKM_MODULES))
endif
ifneq ($(FIRE_KERNEL_6_6_MISSING_SYSTEM_DLKM_LOAD_MODULES),)
$(error Missing Fire 6.6 system_dlkm load modules: $(FIRE_KERNEL_6_6_MISSING_SYSTEM_DLKM_LOAD_MODULES))
endif
endif
TARGET_KERNEL_SOURCE := $(FIRE_KERNEL_6_6_SOURCE)
TARGET_KERNEL_CONFIG := $(FIRE_KERNEL_6_6_PROJECT)_defconfig
BOARD_KERNEL_IMAGE_NAME := $(FIRE_KERNEL_6_6_IMAGE_NAME)
TARGET_PREBUILT_KERNEL := $(FIRE_KERNEL_6_6_DIST_IMAGE)
BOARD_PREBUILT_DTBOIMAGE := $(FIRE_KERNEL_6_6_DIST_DTBO)
BOARD_BOOTIMG_HEADER_VERSION := 3
BOARD_BOOT_HEADER_VERSION := 3
BOARD_KERNEL_PAGESIZE := 4096
BOARD_RAMDISK_USE_LZ4 := true
BOARD_USES_GENERIC_KERNEL_IMAGE := true
BOARD_USES_RECOVERY_AS_BOOT := false
BOARD_MOVE_RECOVERY_RESOURCES_TO_VENDOR_BOOT := true
BOARD_INCLUDE_RECOVERY_RAMDISK_IN_VENDOR_BOOT := true
BOARD_MOVE_GSI_AVB_KEYS_TO_VENDOR_BOOT := true
GENERIC_KERNEL_CMDLINE := $(FIRE_KERNEL_6_6_BOOT_CMDLINE)
BOARD_KERNEL_CMDLINE := $(FIRE_KERNEL_6_6_VENDOR_CMDLINE)
BOARD_USES_VENDOR_DLKMIMAGE := true
BOARD_USES_ODM_DLKMIMAGE := true
BOARD_USES_SYSTEM_DLKMIMAGE := true
TARGET_COPY_OUT_VENDOR_DLKM := vendor_dlkm
TARGET_COPY_OUT_ODM_DLKM := odm_dlkm
TARGET_COPY_OUT_SYSTEM_DLKM := system_dlkm
# AOSP reuses BOARD_MKBOOTIMG_ARGS for boot and vendor_boot. Header v3 keeps
# boot generic, while vendor_boot records the stock LK load addresses.
BOARD_MKBOOTIMG_ARGS = --base $(BOARD_KERNEL_BASE)
BOARD_MKBOOTIMG_ARGS += --kernel_offset $(BOARD_KERNEL_OFFSET)
BOARD_MKBOOTIMG_ARGS += --ramdisk_offset $(BOARD_RAMDISK_OFFSET)
BOARD_MKBOOTIMG_ARGS += --tags_offset $(BOARD_KERNEL_TAGS_OFFSET)
BOARD_MKBOOTIMG_ARGS += --dtb_offset $(BOARD_DTB_OFFSET)
BOARD_MKBOOTIMG_ARGS += --pagesize $(BOARD_KERNEL_PAGESIZE)
BOARD_MKBOOTIMG_ARGS += --header_version $(BOARD_BOOTIMG_HEADER_VERSION)
BOARD_MKBOOTIMG_ARGS += --board ""
BOARD_VENDOR_KERNEL_MODULES += $(FIRE_KERNEL_6_6_VENDOR_DLKM_MODULES)
BOARD_VENDOR_KERNEL_MODULES_LOAD += $(FIRE_KERNEL_6_6_VENDOR_DLKM_MODULE_LOAD_FILES)
BOARD_SYSTEM_KERNEL_MODULES += $(FIRE_KERNEL_6_6_SYSTEM_DLKM_MODULES)
BOARD_SYSTEM_KERNEL_MODULES_LOAD += $(FIRE_KERNEL_6_6_SYSTEM_DLKM_MODULE_LOAD_FILES)
BOARD_VENDOR_RAMDISK_KERNEL_MODULES += $(FIRE_KERNEL_6_6_VENDOR_BOOT_MODULES)
BOARD_VENDOR_RAMDISK_KERNEL_MODULES_LOAD += $(FIRE_KERNEL_6_6_VENDOR_BOOT_MODULE_LOAD_FILES)
BOARD_VENDOR_RAMDISK_RECOVERY_KERNEL_MODULES_LOAD += $(FIRE_KERNEL_6_6_VENDOR_BOOT_RECOVERY_MODULE_LOAD_FILES)

ifeq ($(FIRE_KERNEL_6_6_VENDOR_BOOT),true)
AB_OTA_PARTITIONS += vendor_boot vendor_dlkm odm_dlkm system_dlkm
BOARD_INCLUDE_DTB_IN_BOOTIMG := true
BOARD_VENDOR_BOOTIMAGE_PARTITION_SIZE := $(FIRE_KERNEL_6_6_VENDOR_BOOTIMAGE_PARTITION_SIZE)
BOARD_VENDOR_BOOTIMG_HEADER_VERSION := 3
BOARD_VENDOR_BOOT_HEADER_VERSION := 3
BOARD_AVB_VENDOR_BOOT_ALGORITHM := NONE
BOARD_AVB_VENDOR_BOOT_ROLLBACK_INDEX := 1
BOARD_AVB_VENDOR_BOOT_ROLLBACK_INDEX_LOCATION := 0
endif
else
$(error Unsupported FIRE_KERNEL_VERSION "$(FIRE_KERNEL_VERSION)"; use 4.19 or 6.6)
endif
